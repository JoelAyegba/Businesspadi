# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (Neon) ---
# DATABASE_URL = pooled connection (used at runtime)
# DIRECT_DATABASE_URL = direct connection (used by Prisma migrate)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connect_timeout=30&connection_limit=5&pool_timeout=20"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/dbname?sslmode=require"

# --- Clerk (auth) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/app/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/app/dashboard"
CLERK_WEBHOOK_SECRET="whsec_..."

# --- Cloudinary (logos / receipts) ---

# --- Resend (email) ---
RESEND_API_KEY="re_..."
RESEND_FROM="ReceiptFlow <noreply@yourdomain.com>"
# Svix signing secret for /api/webhooks/resend — route 404s until set
RESEND_WEBHOOK_SECRET="whsec_..."

# --- Paystack (billing, v1) ---
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PRO_PLAN_CODE="PLN_..."

# --- Stripe (billing, stubbed) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Sentry (errors) — optional in dev, required in prod ---
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
